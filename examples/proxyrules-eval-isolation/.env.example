# Example environment variables for the proxyrules eval-isolation example

# the strategy to use
MOCKSTACK__STRATEGY = proxyrules

# strategy-specific settings
# Generate rules.local.yml first -- see README.md's "Run it" section.
MOCKSTACK__PROXYRULES_RULES_FILENAME = "./rules.local.yml"

# To record the fixtures from the real services once (see docs: Recording fixtures),
# uncomment these for a recording run against a safe environment, then review the files:
# MOCKSTACK__PROXYRULES_RECORD_MODE = missing
# MOCKSTACK__PROXYRULES_RECORD_ROOT = "./fixtures"

# OpenTelemetry settings
MOCKSTACK__OPENTELEMETRY__ENABLED = false
